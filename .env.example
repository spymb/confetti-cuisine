# ── 服务器 ──
# 监听端口（Render/Zeabur 等平台会自动注入，本地开发默认 3000，可不填）
PORT=3000

# 运行环境：development / production
# 生产环境必须设为 production（平台后台配置，不要写进仓库）
NODE_ENV=development

# ── 数据库 ──
# 开发环境：留空自动使用内存 MongoDB
# 生产环境：在平台后台注入 MongoDB Atlas 连接串，例如
#   MONGODB_URI=mongodb+srv://user:pass@cluster0.xxx.mongodb.net/confetti-cuisine
MONGODB_URI=

# ── 密钥 ──
# 会话密钥（生产环境必须替换为随机字符串，使用开发默认值会拒绝启动）
# 生成方式：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=dev-secret-change-in-production

# JWT 签名密钥（生产环境必须替换为随机字符串，且与 SESSION_SECRET 不同）
# 生成方式：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=dev-jwt-secret-change-in-production
